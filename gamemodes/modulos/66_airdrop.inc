stock AirDrop_Iniciar()
{
	printf("Random AirDrop System by Nima Bastaniw loaded !"); //DON'T REMOVE CREDITS
	//pak nakon BA HOVIAT :D
	printf("I'll drop an AirDrop every %d secound(s) !", AirDropTime);

	// Aviso en pantalla: misma posicion y fuente que el de /puente, en rojo.

	LastAirDropUsed = 1;
	AirDropTimerCount = 0;
	LastAirDropFindTimer = 0;
	g_AirDropAterrizado = false;
	if (AirDropTimer) KillTimer(AirDropTimer);
	AirDropTimer = SetTimer("AirDropCount", 1000, true);
	return 1;
}

stock AirDrop_OnConectar(playerid)
{
	SendClientMessage(playerid, -1, "Este servidor usa el sistema AirDrop de NimaBastaniw !"); //DON'T REMOVE CREDITS
	// Aviso de caida (16/10/2026): PlayerTextDraw por jugador, como /puente (22_dropeo.inc).
	g_AirDropTD[playerid][0] = CreatePlayerTextDraw(playerid, 320.0, 380.0, "AIRDROP!");
	PlayerTextDrawAlignment(playerid, g_AirDropTD[playerid][0], TEXT_DRAW_ALIGN_CENTRE);
	PlayerTextDrawFont(playerid, g_AirDropTD[playerid][0], TEXT_DRAW_FONT_PRICEDOWN);
	PlayerTextDrawLetterSize(playerid, g_AirDropTD[playerid][0], 0.42, 1.8);
	PlayerTextDrawColour(playerid, g_AirDropTD[playerid][0], 0xFF0000FF);
	PlayerTextDrawSetOutline(playerid, g_AirDropTD[playerid][0], 1);
	PlayerTextDrawSetShadow(playerid, g_AirDropTD[playerid][0], 0);
	PlayerTextDrawSetProportional(playerid, g_AirDropTD[playerid][0], true);

	g_AirDropTD[playerid][1] = CreatePlayerTextDraw(playerid, 320.0, 402.0, "-");
	PlayerTextDrawAlignment(playerid, g_AirDropTD[playerid][1], TEXT_DRAW_ALIGN_CENTRE);
	PlayerTextDrawFont(playerid, g_AirDropTD[playerid][1], TEXT_DRAW_FONT_PRICEDOWN);
	PlayerTextDrawLetterSize(playerid, g_AirDropTD[playerid][1], 0.24, 1.2);
	PlayerTextDrawColour(playerid, g_AirDropTD[playerid][1], 0xFFFFFFFF);
	PlayerTextDrawSetOutline(playerid, g_AirDropTD[playerid][1], 1);
	PlayerTextDrawSetShadow(playerid, g_AirDropTD[playerid][1], 0);
	PlayerTextDrawSetProportional(playerid, g_AirDropTD[playerid][1], true);
	return 1;
}

stock AirDrop_HayJugadores()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i) && !IsPlayerNPC(i)) return 1;
	}
	return 0;
}

// Quita la caja, su texto y su icono del mapa (el original lo repetia suelto).
stock AirDrop_Retirar()
{
	if (IsValidDynamicObject(LastAirDrop[adobjectid])) DestroyDynamicObject(LastAirDrop[adobjectid]);
	if (IsValidDynamic3DTextLabel(LastAirDrop[Text3Did])) DestroyDynamic3DTextLabel(LastAirDrop[Text3Did]);
	if (IsValidDynamicMapIcon(LastAirDrop[adIconoid])) DestroyDynamicMapIcon(LastAirDrop[adIconoid]);
	LastAirDrop[adobjectid] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
	LastAirDrop[Text3Did] = STREAMER_TAG_3D_TEXT_LABEL:INVALID_STREAMER_ID;
	LastAirDrop[adIconoid] = STREAMER_TAG_MAP_ICON:INVALID_STREAMER_ID;
	g_AirDropAterrizado = false;
	return 1;
}

//1800 secounds = 30 minutes (aqui AirDropTime = 3600 = 60 minutes)
forward AirDropCount();
public AirDropCount()
{
	if(LastAirDropUsed == 0)
	{
		LastAirDropFindTimer++; // el original no lo incrementaba nunca
		if(LastAirDropFindTimer >= AfterDropDestroyTimer)
		{
			LastAirDropUsed = 1; // el original dejaba 0 y no volvia a caer otro
			LastAirDropFindTimer = 0;
			AirDropTimerCount = 0;
			AirDrop_Retirar();
		}
		return 1;
	}
	if(AirDropTimerCount >= AirDropTime)
	{
		if (!AirDrop_HayJugadores()) return 1; // nadie conectado: espera
		AirDropTimerCount = 0;
		DropIt();
	}
	AirDropTimerCount++;
	return 1;
}

forward AirDrop_PararSirena();
public AirDrop_PararSirena()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i)) PlayerPlaySound(i, 0, 0.0, 0.0, 0.0); // 0 = para el sonido en curso
	}
	return 1;
}

forward AirDrop_OcultarAviso();
public AirDrop_OcultarAviso()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
		PlayerTextDrawHide(i, g_AirDropTD[i][0]);
		PlayerTextDrawHide(i, g_AirDropTD[i][1]);
	}
	return 1;
}

// Aviso de caida: pantalla en rojo + bocina + sirena. Sin aviso a la policia.
stock AirDrop_Alerta(const zone[])
{
	new texto[96];
	format(texto, sizeof texto, "Cae un AirDrop en Los Santos - %s", zone);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (!IsPlayerConnected(i) || IsPlayerNPC(i)) continue;
		PlayerTextDrawSetString(i, g_AirDropTD[i][1], texto);
		PlayerTextDrawShow(i, g_AirDropTD[i][0]);
		PlayerTextDrawShow(i, g_AirDropTD[i][1]);
	}
	SetTimer("AirDrop_OcultarAviso", 8000, false);
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i)) PlayerPlaySound(i, 3201, 0.0, 0.0, 0.0); // bocina larga
	}
	SetTimer("AirDrop_Sirena", 1500, false);
	SetTimer("AirDrop_PararSirena", 7000, false);
	return 1;
}

forward AirDrop_Sirena();
public AirDrop_Sirena()
{
	for (new i = 0; i < MAX_PLAYERS; i++)
	{
		if (IsPlayerConnected(i)) PlayerPlaySound(i, 6001, 0.0, 0.0, 0.0); // sirena que se repite
	}
	return 1;
}

stock DropIt()
{
	LastAirDropUsed = 0;
	new Float:rX, Float:rY, Float:rayoZ, Float:rx = 0.0, Float:ry = 0.0, Float:rz = 0.0;
	new zone[52];
	// El original elegia X/Y al azar y tiraba un rayo para hallar el suelo; aqui
	// se elige un punto de suelo ya medido (g_AirDropSuelo), con el mismo filtro de zona.
	new intentos = 0, idx;
	do
	{
		idx = random(sizeof g_AirDropSuelo);
		rX = g_AirDropSuelo[idx][0];
		rY = g_AirDropSuelo[idx][1];
		rayoZ = g_AirDropSuelo[idx][2];
		zone[0] = 0;
		Get2DZoneName(rX, rY, zone, sizeof(zone));
		intentos++;
	}
	while (!strcmp(zone, "Los Santos", true) && intentos < 30);
	if (!strcmp(zone, "Los Santos", true)) { LastAirDropUsed = 1; return 0; }
	if (!strlen(zone)) format(zone, sizeof(zone), "San Andreas");

	new string[512];
	format(string, sizeof(string), "[AirDrop] : Un AirDrop esta cayendo en Los Santos - %s, corre a buscarlo !", zone);
	SendClientMessageToAll(0xFF0000FF, string);
	AirDrop_Alerta(zone);

	LastAirDrop[rayX] = rX;
	LastAirDrop[rayY] = rY;
	LastAirDrop[rayZ] = rayoZ;
	LastAirDrop[rayRX] = rx;
	LastAirDrop[rayRY] = ry;
	LastAirDrop[rayRZ] = rz;
	LastAirDropFindTimer = 0;
	g_AirDropAterrizado = false;
	LastAirDrop[adobjectid] = CreateDynamicObject(1271, rX, rY, rayoZ+100, 0.0, 0.0, 0.0);
	MoveDynamicObject(LastAirDrop[adobjectid], rX, rY, rayoZ+2.5, 4.0);
	// Icono rojo en el mapa, visible desde cualquier punto del mapa.
	LastAirDrop[adIconoid] = CreateDynamicMapIcon(rX, rY, rayoZ, 0, 0xFF0000FF, -1, -1, -1, 20000.0, MAPICON_GLOBAL);
	return 1;
}

public OnDynamicObjectMoved(STREAMER_TAG_OBJECT:objectid)
{
	if(objectid == LastAirDrop[adobjectid])
	{
		new Float:x, Float:y, Float:z;
		GetDynamicObjectPos(objectid, x, y, z);
		LastAirDrop[Text3Did] = CreateDynamic3DTextLabel("AirDrop\n Escribe /recogercaja para recoger", 0xFF0000FF, x, y, z, 24);
		g_AirDropAterrizado = true;
	}
	return 1;
}

CMD:gotoairdrop(playerid, params[])
{
	if (NoPuedeJugar(playerid)) return 1;
	if (SinPermiso(playerid, AIRDROP_ADMIN_NIVEL)) return 1;
	if(LastAirDropUsed == 1) return Error(playerid, "No hay ningun AirDrop activo.");
	new Float:x, Float:y, Float:z;
	GetDynamicObjectPos(LastAirDrop[adobjectid], x, y, z);
	SetPlayerPos(playerid, x, y, z+4.0);
	return 1;
}
CMD:resetairdrop(playerid, params[])
{
	if (NoPuedeJugar(playerid)) return 1;
	if (SinPermiso(playerid, AIRDROP_ADMIN_NIVEL)) return 1;
	LastAirDropUsed = 1;
	AirDropTimerCount = 0;
	LastAirDropFindTimer = 0;
	AirDrop_Retirar();
	return Aviso(playerid, "AirDrop retirado y cuenta atras reiniciada.");
}
// Extra de Gamerol (no existe en el original): fuerza una caida ahora mismo.
CMD:airdropahora(playerid, params[])
{
	if (NoPuedeJugar(playerid)) return 1;
	if (SinPermiso(playerid, AIRDROP_ADMIN_NIVEL)) return 1;
	if(LastAirDropUsed == 0) return Error(playerid, "Ya hay un AirDrop activo.");
	AirDropTimerCount = 0;
	DropIt();
	return 1;
}
// Comando del jugador: en el original es /getdrop; aqui /recogercaja.
CMD:recogercaja(playerid, params[])
{
	if (NoPuedeJugar(playerid)) return 1;
	if(LastAirDropUsed == 1) return Error(playerid, "No hay ningun AirDrop activo.");
	if(!g_AirDropAterrizado) return Error(playerid, "El AirDrop todavia esta cayendo.");
	new Float:x, Float:y, Float:z;
	GetDynamicObjectPos(LastAirDrop[adobjectid], x, y, z);
	if(IsPlayerInRangeOfPoint(playerid, 5.0, x, y, z+2))
	{
		// Los materiales son un item: si no caben, no se gasta la caja.
		if (Inv_DarItem(playerid, Item_Buscar("Materiales"), AIRDROP_MATERIALES, 0) == -1)
		{
			return Error(playerid, "Llevas demasiado peso encima: el AirDrop no te cabe en el inventario.");
		}
		LastAirDropUsed = 1;
		for(new i = 1; i < 4; i++)
		{
			new string[256];
			if (i == 1)
			{
				DarDinero(playerid, AIRDROP_DINERO);
				format(string, sizeof(string), "[AirDrop] : Has recogido %d $.", AIRDROP_DINERO);
			}
			else if (i == 2)
			{
				format(string, sizeof(string), "[AirDrop] : Has recogido %d Materiales.", AIRDROP_MATERIALES);
			}
			else
			{
				GivePlayerWeapon(playerid, WEAPON:AIRDROP_ARMA, AIRDROP_MUNICION);
				format(string, sizeof(string), "[AirDrop] : Has recogido Pistola silenciada (%d balas).", AIRDROP_MUNICION);
			}
			SendClientMessage(playerid, 0xFF0000FF, string);
		}
		AirDrop_Retirar();
		AirDropTimerCount = 0;
		new nombre[MAX_PLAYER_NAME + 1], aviso[128];
		GetPlayerName(playerid, nombre, sizeof nombre);
		format(aviso, sizeof aviso, "[AirDrop] : %s ha recogido el AirDrop.", nombre);
		SendClientMessageToAll(0xFF0000FF, aviso);
	}
	else Error(playerid, "Estas demasiado lejos del AirDrop.");
	return 1;
}

