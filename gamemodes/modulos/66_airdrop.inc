{
	STREAMER_TAG_OBJECT:adobjectid,
	Float:rayX,
	Float:rayY,
	Float:rayZ,
	Float:rayRX,
	Float:rayRY,
	Float:rayRZ,
	STREAMER_TAG_3D_TEXT_LABEL:Text3Did,
