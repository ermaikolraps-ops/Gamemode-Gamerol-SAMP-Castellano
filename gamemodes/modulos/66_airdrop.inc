};
new LastAirDrop[airdrop_Data];
new LastAirDropFindTimer;
new bool:g_AirDropAterrizado;
new PlayerText:g_AirDropTD[MAX_PLAYERS][2]; // 16/10/2026: aviso por jugador, mismo patron que /puente

